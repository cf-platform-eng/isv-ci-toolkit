unset PYTHONPATH
source $(pipenv --venv)/bin/activate
export PIP_INDEX_URL="${PIP_INDEX_URL:-$(vault kv get -field=url concourse/ppe-isv/pip_index 2>/dev/null)}"
if [ -z "${PIP_INDEX_URL}" ]; then
  echo "ERROR: PIP_INDEX_URL is not set. Need to set the PIP_INDEX_URL environment variable or run 'vault login'"
  return 1
fi
echo "Your virtualenv is in $(pipenv --venv)"
